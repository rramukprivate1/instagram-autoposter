# ============================================================
# Instagram Auto-Poster: Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it is in .gitignore.
# All these values must also be added as GitHub Actions Secrets.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Instagram / Meta Graph API ---
IG_ACCESS_TOKEN=your-long-lived-instagram-access-token
IG_ACCOUNT_ID=your-instagram-business-account-id

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
APPROVAL_TO_EMAIL=your-personal-email@gmail.com

# --- App URL ---
# The URL where your admin panel is deployed (used in email approval links)
APP_BASE_URL=https://your-app.vercel.app

# --- Image Settings (optional, defaults shown) ---
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
IMAGE_OUTPUT_DIR=/tmp/posts

# --- Deduplication (optional, defaults shown) ---
DUPLICATE_SIMILARITY_THRESHOLD=0.85
DUPLICATE_LOOKBACK_DAYS=30
